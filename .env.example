# Copy to .env and fill. Never commit .env. Variables are read ONLY in src/shared/config/env.ts.

# --- Database (required) ---
MONGODB_URL=
# Integration tests only (separate DB!)
MONGODB_TEST_URL=

# --- Auth (required) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (S7, optional: button hidden when empty) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- S3 images (S4) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Optional, for non-AWS S3-compatible storage
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Trial / billing (S5, S8) ---
TRIAL_DAYS=10
GRACE_DAYS=2
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
BILLING_PRICE_LABEL=
CRON_SECRET=

# --- Egypt wallets (S9; a method without a value is hidden) ---
WALLET_PRICE_EGP=
WALLET_PERIOD_DAYS=30
WALLET_VODAFONE_NUMBER=
WALLET_ETISALAT_NUMBER=
WALLET_ORANGE_NUMBER=
WALLET_INSTAPAY_HANDLE=
